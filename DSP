desc: REA Dynamic EQ Multi-Band Core (2-Band Engine)
// @author Rea (Reaper Queen) / Alicia4preZ

// --- Band 1 ---
slider1:0<0,2,1{Bell,Low Shelf,High Shelf}>B1 Type
slider2:150<20,20000,1>B1 Frequency (Hz)
slider3:1.0<0.1,10,0.01>B1 Q
slider4:0<-24,24,0.1>B1 Static Gain (dB)
slider5:-6<-24,24,0.1>B1 Dynamic Range (dB)
slider6:-18<-60,0,0.1>B1 Threshold (dBFS)

// --- Band 2 ---
slider11:0<0,2,1{Bell,Low Shelf,High Shelf}>B2 Type
slider12:2500<20,20000,1>B2 Frequency (Hz)
slider13:1.0<0.1,10,0.01>B2 Q
slider14:0<-24,24,0.1>B2 Static Gain (dB)
slider15:-6<-24,24,0.1>B2 Dynamic Range (dB)
slider16:-18<-60,0,0.1>B2 Threshold (dBFS)

// --- Global Dynamics ---
slider21:5<0.1,100,0.1>Attack (ms)
slider22:50<5,500,0.1>Release (ms)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
// Universal Biquad Calculator
function calc_filter(type, f, q, gain_db)
instance(b0, b1, b2, a1, a2)
(
  A = 10^(gain_db/40);
  w0 = 2 * $pi * max(min(f, srate*0.49), 20) / srate;
  cos_w0 = cos(w0);
  sin_w0 = sin(w0);
  alpha = sin_w0 / (2 * q);

  type == 0 ? ( // 0 = Bell
    a0 = 1 + alpha / A;
    b0 = (1 + alpha * A) / a0;
    b1 = (-2 * cos_w0) / a0;
    b2 = (1 - alpha * A) / a0;
    a1 = (-2 * cos_w0) / a0;
    a2 = (1 - alpha / A) / a0;
  ) :
  type == 1 ? ( // 1 = Low Shelf
    sqA = sqrt(A);
    a0 = (A+1) + (A-1)*cos_w0 + 2*sqA*alpha;
    b0 = (A*( (A+1) - (A-1)*cos_w0 + 2*sqA*alpha )) / a0;
    b1 = (2*A*( (A-1) - (A+1)*cos_w0 )) / a0;
    b2 = (A*( (A+1) - (A-1)*cos_w0 - 2*sqA*alpha )) / a0;
    a1 = (-2*( (A-1) + (A+1)*cos_w0 )) / a0;
    a2 = ((A+1) + (A-1)*cos_w0 - 2*sqA*alpha) / a0;
  ) :
  type == 2 ? ( // 2 = High Shelf
    sqA = sqrt(A);
    a0 = (A+1) - (A-1)*cos_w0 + 2*sqA*alpha;
    b0 = (A*( (A+1) + (A-1)*cos_w0 + 2*sqA*alpha )) / a0;
    b1 = (-2*A*( (A-1) + (A+1)*cos_w0 )) / a0;
    b2 = (A*( (A+1) + (A-1)*cos_w0 - 2*sqA*alpha )) / a0;
    a1 = (2*( (A-1) - (A+1)*cos_w0 )) / a0;
    a2 = ((A+1) - (A-1)*cos_w0 - 2*sqA*alpha) / a0;
  );
);

// Biquad Audio Processor
function process(x)
instance(b0, b1, b2, a1, a2, x1, x2, y1, y2)
(
  y = b0*x + b1*x1 + b2*x2 - a1*y1 - a2*y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);

// Envelope Follower
function env_detect(in, att_ms, rel_ms)
instance(env, att_coeff, rel_coeff)
(
  att_coeff = exp(-1000 / (att_ms * srate));
  rel_coeff = exp(-1000 / (rel_ms * srate));
  in_abs = abs(in);
  env = in_abs > env ? att_coeff * env + (1 - att_coeff) * in_abs : rel_coeff * env + (1 - rel_coeff) * in_abs;
  env;
);

@sample
// Detect input level for dynamic envelopes
detect_in = (spl0 + spl1) * 0.5;
env_val = env_global.env_detect(detect_in, slider21, slider22);
env_db = 20 * log10(env_val + 0.000001);

// --- BAND 1 PROCESSING ---
over_thresh_b1 = max(0, env_db - slider6);
dyn_gain_b1 = min(over_thresh_b1 * 0.5, abs(slider5)) * sign(slider5);
smooth_dyn_b1 += (dyn_gain_b1 - smooth_dyn_b1) * 0.005;
target_gain_b1 = slider4 + smooth_dyn_b1;

filt_L_b1.calc_filter(slider1, slider2, slider3, target_gain_b1);
filt_R_b1.calc_filter(slider1, slider2, slider3, target_gain_b1);

spl0 = filt_L_b1.process(spl0);
spl1 = filt_R_b1.process(spl1);

// --- BAND 2 PROCESSING ---
// Detection can be sourced from pre-EQ or post-Band 1 EQ depending on routing goals. 
// Here, we use the global detection for independent trigger levels.
over_thresh_b2 = max(0, env_db - slider16);
dyn_gain_b2 = min(over_thresh_b2 * 0.5, abs(slider15)) * sign(slider15);
smooth_dyn_b2 += (dyn_gain_b2 - smooth_dyn_b2) * 0.005;
target_gain_b2 = slider14 + smooth_dyn_b2;

filt_L_b2.calc_filter(slider11, slider12, slider13, target_gain_b2);
filt_R_b2.calc_filter(slider11, slider12, slider13, target_gain_b2);

spl0 = filt_L_b2.process(spl0);
spl1 = filt_R_b2.process(spl1);
