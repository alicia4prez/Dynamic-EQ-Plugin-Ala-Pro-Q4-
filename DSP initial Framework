slider1:1000<20,20000,1>Frequency (Hz)
slider2:1<0.1,10,0.01>Q
slider3:0<-24,24,0.1>Static Gain (dB)
slider4:-6<-24,24,0.1>Dynamic Range (dB)
slider5:-18<-60,0,0.1>Threshold (dBFS)
slider6:5<0.1,100,0.1>Attack (ms)
slider7:50<5,500,0.1>Release (ms)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
// Biquad Coefficient Calculator (Direct Form 1)
function biquad_calc_bell(f, q, gain_db)
instance(b0, b1, b2, a1, a2)
(
  A = 10^(gain_db/40);
  w0 = 2 * $pi * f / srate;
  cos_w0 = cos(w0);
  sin_w0 = sin(w0);
  alpha = sin_w0 / (2 * q);

  a0 = 1 + alpha / A;
  b0 = (1 + alpha * A) / a0;
  b1 = (-2 * cos_w0) / a0;
  b2 = (1 - alpha * A) / a0;
  a1 = (-2 * cos_w0) / a0;
  a2 = (1 - alpha / A) / a0;
);

// Biquad Audio Processor
function biquad_process(x)
instance(b0, b1, b2, a1, a2, x1, x2, y1, y2)
(
  y = b0*x + b1*x1 + b2*x2 - a1*y1 - a2*y2;
  x2 = x1;
  x1 = x;
  y2 = y1;
  y1 = y;
  y;
);

// Envelope Follower for Dynamic Detection
function env_detect(in, att_ms, rel_ms)
instance(env, att_coeff, rel_coeff)
(
  att_coeff = exp(-1000 / (att_ms * srate));
  rel_coeff = exp(-1000 / (rel_ms * srate));
  
  in_abs = abs(in);
  env = in_abs > env ? att_coeff * env + (1 - att_coeff) * in_abs : rel_coeff * env + (1 - rel_coeff) * in_abs;
  env;
);

@sample
// 1. Detect level (summing L and R for mono detection)
detect_in = (spl0 + spl1) * 0.5;

// 2. Run envelope follower
env_val = env.env_detect(detect_in, slider6, slider7);
env_db = 20 * log10(env_val + 0.000001);

// 3. Calculate dynamic gain reduction or expansion
over_threshold = max(0, env_db - slider5);

// Map the threshold overflow to the target dynamic range.
// A negative slider4 acts as compression; a positive acts as expansion.
dyn_gain = min(over_threshold * 0.5, abs(slider4)) * sign(slider4); 

// Smooth the dynamic gain change to prevent distortion/zipper noise
smooth_dyn_gain += (dyn_gain - smooth_dyn_gain) * 0.005;

// 4. Calculate total target gain
target_gain = slider3 + smooth_dyn_gain;

// 5. Recalculate filter coefficients per sample
filt_L.biquad_calc_bell(slider1, slider2, target_gain);
filt_R.biquad_calc_bell(slider1, slider2, target_gain);

// 6. Process the audio stream
spl0 = filt_L.biquad_process(spl0);
spl1 = filt_R.biquad_process(spl1);
